GROQ_API_KEY=
HF_TOKEN=
TOKENIZERS_PARALLELISM=false
OCR_AGENT=unstructured.partition.utils.ocr_models.tesseract_ocr.OCRAgentTesseract

# --- Grounded answer providers (backend/providers.py) -------------------------------------------------------------
# Used only when TG_GROUNDED_ANSWERS is on AND the document lifecycle registry (legal/lifecycle) has servable documents; otherwise nothing is called.
# Order: Groq -> Cerebras -> Gemini -> Ollama. Copy to .env (gitignored) and put real keys there, never in this file.
# Placeholder values ("your-...") count as "no key": that provider is skipped.
GROQ_ENABLED=true
# GROQ_API_KEY (above) is shared with the legacy development path.
GROQ_MODEL=openai/gpt-oss-120b

CEREBRAS_ENABLED=true
CEREBRAS_API_KEY=your-cerebras-api-key
CEREBRAS_MODEL=gpt-oss-120b

GEMINI_ENABLED=true
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Structured output: the provider enforces the response shape (the validator still checks everything).
GROQ_STRUCTURED_OUTPUT=true
CEREBRAS_STRUCTURED_OUTPUT=true
GEMINI_STRUCTURED_OUTPUT=true
# shapes (answer / refusal / clarification only - best for small local models) | schema | json
OLLAMA_FORMAT=shapes

# Seconds per HTTP call (Ollama runs locally and is slower).
PROVIDER_TIMEOUT_SECONDS=30
OLLAMA_TIMEOUT_SECONDS=120
# Extra attempts on the SAME provider, only for rate limits, 5xx and connection errors (0-3).
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_BACKOFF_SECONDS=0.5
# A provider asking to wait longer than this is skipped instead of waited for.
PROVIDER_MAX_RETRY_WAIT_SECONDS=5
PROVIDER_MAX_OUTPUT_TOKENS=4096
# How many times a validator-rejected answer may be replaced by the next provider's answer (0-2).
PROVIDER_VALIDATION_FALLBACKS=1

# --- Query embeddings (Stage 7A). Independent of the generation providers above. ---
# Local development default: Ollama nomic-embed-text, exactly as before. Nothing below needs to be set locally.
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Hosted (cloud), Stage 7B: NO provider is approved yet (see eval/deployment/STAGE-7B-REPORT.md). A hosted provider must serve the
# SAME model as the stored index (nomic-embed-text v1.5, 768 dimensions) and be zero-cost for this use; it never falls back to
# Ollama, and a cloud deployment (TG_SNAPSHOT_STORE=r2) refuses to start embeddings without EMBEDDING_PROVIDER set explicitly.
# Supported adapters: nomic_atlas (Nomic's own API, task_type) and openai_compatible (/embeddings). Set the key in the host's
# secret store, never in a file that is committed and never in the frontend. Example, once an account exists and was verified:
# EMBEDDING_PROVIDER=nomic_atlas
# EMBEDDING_MODEL=nomic-embed-text-v1.5
# EMBEDDING_API_KEY=
# EMBEDDING_TIMEOUT_SECONDS=10
# EMBEDDING_MAX_RETRIES=2
# See deploy/cloud.env.example for the full cloud set (snapshot store, CORS, lifecycle).

# Step 4 provision-level validity (backend/provision_validity_runtime.py). Unset/off = nothing changes. restrict = the validity ledger chain must
# pass the acceptance gate before any legal chunk is served, and the ledger can only remove chunks; shadow = log only. Any other value
# (including enforce, which is locked) serves nothing. Replay/freshness protection is NOT implemented yet.
# TG_PROVISION_VALIDITY=off
# TG_VALIDITY_LEDGER_FILE=
# TG_VALIDITY_DECISION_REGISTER_FILE=
# TG_VALIDITY_EVIDENCE_MANIFEST_FILE=
# TG_VALIDITY_EVIDENCE_DIR=

# Secondary source: amounts displayed on the Telangana Police e-Challan website (backend/echallan_fines.py). Off by default;
# set to 1 to answer "what is the fine for ..." from the two scraped tables. Not independently verified, not legal evidence.
# TG_ECHALLAN_FINES=1
