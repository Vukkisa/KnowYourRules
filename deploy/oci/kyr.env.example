# /etc/kyr/kyr.env for the OCI VM. Placeholders only (the same names the validator treats as unset): real values go in the file on the
# VM, owner root, mode 0600, never in git. Validate a candidate file without starting anything:
#     set -a; . /etc/kyr/kyr.env; set +a; /opt/kyr/venv/bin/python /opt/kyr/app/scripts/check_cloud_env.py
# This file sets NO rate-limit, size, concurrency or session variable on purpose: the application's defaults (10 questions per client
# per minute, 8,192-byte body, 2 concurrent questions, 500 sessions, 30 minutes idle) stay in force.
TG_ENVIRONMENT=production
TG_CLOUD=1
TG_GROUNDED_ANSWERS=1
OLLAMA_ENABLED=false

# Generation: Groq -> Gemini -> a fixed "unavailable" reply. A key left as a placeholder counts as not set.
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key
# Bound the worst case (two providers, no retry): about 31 s with retrieval, which the Caddyfile's 60 s limits cover. The defaults
# (30 s, one retry) allow about 130 s and would be cut off by Caddy.
PROVIDER_TIMEOUT_SECONDS=12
PROVIDER_MAX_RETRIES=0

# Query embeddings: the index's own model inside this process. The file and its SHA-256 are the ones the index was built with.
EMBEDDING_PROVIDER=inprocess_nomic
EMBEDDING_MODEL_FILE=/srv/kyr/model/nomic-embed-text-v1.5.f16.gguf
EMBEDDING_MODEL_SHA256=970aa74c0a90ef7482477cf803618e776e173c007bf957f635f1015bfcfef0e6

# Corpus: one verified snapshot on the persistent volume (mounted at /srv/kyr through /etc/fstab).
TG_SNAPSHOT_STORE=local
TG_SNAPSHOT_MOUNT_POINT=/srv/kyr
TG_SNAPSHOT_LOCAL_DIR=/srv/kyr/snapshots
TG_SNAPSHOT_WORK_DIR=/srv/kyr/work
TG_SNAPSHOT_MIN_FREE_MB=1024
# The sha256 of the manifest you reviewed (python -m backend.index_snapshot pin). It changes with every publish.
TG_SNAPSHOT_PIN_SHA256=your-reviewed-manifest-sha256
TG_SNAPSHOT_EXPECT_FAMILY=nomic-embed-text-v1.5
TG_SOURCE_STATUS_FILE=legal-status/source-status.json

# Only Caddy on this machine may tell the application a client's address.
TG_TRUSTED_PROXIES=127.0.0.1,::1

# The GitHub Pages origin that may call the API: an exact https origin, no path, no wildcard.
TG_CORS_ORIGINS=https://your-github-user.github.io

# Legal approval: there is no signed record. Answers are served from documents that are approved and active in the lifecycle registry.
# TG_APPROVAL_FILE / TG_TRUSTED_KEYS_FILE are read only by the optional TG_PROVISION_VALIDITY layer (off by default); leave them unset.

RAG_VECTOR_SEARCH=exact
ANONYMIZED_TELEMETRY=False
