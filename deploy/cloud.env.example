# Environment for the cloud backend. Placeholders only: real values go in the Render dashboard, never in git.
# Validate a candidate environment without starting anything:  python scripts/check_cloud_env.py
TG_ENVIRONMENT=production
TG_GROUNDED_ANSWERS=1
OLLAMA_ENABLED=false
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key

# Query embeddings (independent of the generation providers above). Must be the model the index was built with
# (nomic-embed-text v1.5, 768 dimensions). STAGE 7B: NO PROVIDER IS APPROVED YET, so these have no default and the service stays
# "not ready" until they are set (a cloud deployment never falls back to Ollama). Choose one adapter after verifying that the
# account is zero-cost for this use and that the snapshot's probe check passes (eval/deployment/STAGE-7B-REPORT.md, section 3).
EMBEDDING_PROVIDER=your-adapter-nomic_atlas-or-openai_compatible
EMBEDDING_MODEL=your-model-id
EMBEDDING_API_KEY=your-embedding-key
# EMBEDDING_API_URL is needed for openai_compatible only (nomic_atlas defaults to Nomic's own endpoint)
# Stage 7C: EMBEDDING_PROVIDER=inprocess_nomic runs the index's own model inside the server (no hosted provider, no account). It needs:
#   EMBEDDING_MODEL_FILE=/path/to/nomic-embed-text-v1.5.f16.gguf   the weights the index was built with (262 MB)
#   EMBEDDING_MODEL_SHA256=<64 hex>                                  MANDATORY: sha256sum of that file; the server refuses any other file
#   (EMBEDDING_MODEL, if set, must be nomic-embed-text-v1.5.) The snapshot's probe vectors must still match: cosine >= 0.995, never lowered.
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_MAX_RETRIES=2

# Snapshot store (Cloudflare R2). Runtime token = read-only. Leave TG_DB_DIR and TG_LIFECYCLE_DIR UNSET.
TG_SNAPSHOT_STORE=r2
R2_ACCOUNT_ID=your-account-id
R2_BUCKET=your-bucket
R2_ACCESS_KEY_ID=your-read-only-access-key-id
R2_SECRET_ACCESS_KEY=your-read-only-secret
# MANDATORY in production: the sha256 of the manifest you reviewed. Get it from the operator machine (publisher credentials) with:
#     python -m backend.index_snapshot pin
# It changes with every published snapshot: update it, and restart, when you deliberately move to a new snapshot.
TG_SNAPSHOT_PIN_SHA256=your-reviewed-manifest-sha256
TG_SNAPSHOT_EXPECT_FAMILY=nomic-embed-text-v1.5
# OCI (Always Free VM): the snapshot lives on a persistent block volume instead of R2. Replace the R2_* lines above with these, and
# set TG_SNAPSHOT_STORE=local. scripts/check_cloud_env.py then REFUSES to start unless the volume is really mounted, the directory
# already exists on it, is writable and has room; nothing is created and nothing falls back to a temporary path. Publish and pin the
# snapshot first (python -m backend.index_snapshot publish / pin) with the same TG_SNAPSHOT_STORE=local and TG_SNAPSHOT_LOCAL_DIR.
# TG_SNAPSHOT_STORE=local
# TG_CLOUD=1                                   # REQUIRED with a local store: keeps the cloud safeguards (no Ollama fallback, model SHA-256)
# TG_SNAPSHOT_MOUNT_POINT=/srv/kyr             # the mounted volume itself; must be a mount point (os.path.ismount), not a plain folder
# TG_SNAPSHOT_LOCAL_DIR=/srv/kyr/snapshots     # inside the mount point; must already exist
# TG_SNAPSHOT_WORK_DIR=/srv/kyr/work           # explicit, existing, writable, not under /tmp: the restore extracts the snapshot here
# TG_SNAPSHOT_MIN_FREE_MB=1024                 # free space required in both directories (64-1048576; default 1024)
# Restore at start (optional): bounded retries for an unreachable store only; integrity failures are never retried.
# TG_SNAPSHOT_STARTUP_TIMEOUT_SECONDS=60
# TG_SNAPSHOT_RETRY_BASE_SECONDS=1
# TG_SNAPSHOT_RETRY_MAX_DELAY_SECONDS=15

# GitHub Pages origin allowed to call the API. MANDATORY in production: exact https origin(s), comma separated, no path, no wildcard,
# no localhost. Use the real site's origin (https://<owner>.github.io); this file does not guess it.
TG_CORS_ORIGINS=https://your-github-user.github.io

# API protection (OCI pilot Stage 1), POST /chat only. In-process: limits are per worker, NOT distributed, so keep ONE worker.
# Every value is optional; an invalid one is ignored (the default below is used) and reported by name in /status.
# TG_RATE_LIMIT_REQUESTS=10            # accepted questions per client per window (1-1000)
# TG_RATE_LIMIT_WINDOW_SECONDS=60      # (1-3600)
# TG_RATE_LIMIT_MAX_CLIENTS=10000      # tracked clients; bounds memory (100-1000000)
# TG_MAX_REQUEST_BYTES=8192            # request body cap, HTTP 413 above it (256-1048576)
# TG_MAX_CONCURRENT_QUESTIONS=2        # questions answered at once; more get HTTP 503 + Retry-After (1-32)
# TG_SESSION_MAX=500                   # live conversations held in memory (1-100000). When all are in use a NEW conversation is
#                                      # refused with HTTP 503 + Retry-After; a live conversation is never evicted.
# TG_SESSION_TTL_SECONDS=1800          # idle seconds (30 minutes) before a conversation is forgotten and its slot freed (60-86400)
# Reverse proxies whose X-Forwarded-For is believed: exact IPs or CIDRs, comma separated. Leave unset when the app is reached
# directly: the header is then ignored entirely. Behind a same-host proxy (Caddy) use the proxy's address, e.g. 127.0.0.1,::1,
# and start uvicorn with --no-proxy-headers so only this one mechanism decides the client address. "*" and /0 are rejected.
# TG_TRUSTED_PROXIES=
