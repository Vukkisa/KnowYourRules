# Environment variables for the Vercel project (Settings -> Environment Variables, Production). PLACEHOLDERS ONLY: real values go in
# Vercel, never in this repository. Variables not listed here keep the application's defaults on purpose: the rate limit (10 questions
# per client per minute), 8,192-byte request body, 2 concurrent questions, 500 sessions and 1,800 s idle time are NOT overridden.
#
# backend/vercel_runtime.py fills in (unless you set them): TG_CLOUD=1, OLLAMA_ENABLED=false, TG_GROUNDED_ANSWERS=1,
# EMBEDDING_PROVIDER=inprocess_nomic, EMBEDDING_MODEL_SHA256 (the pinned hash), EMBEDDING_MODEL_SOURCE=memory (the model is held in RAM, no file) and
# TG_SNAPSHOT_WORK_DIR (under /tmp), TG_SNAPSHOT_STORE=local, TG_SNAPSHOT_LOCAL_DIR (the bundled snapshot-store/), TG_SNAPSHOT_EXPECT_FAMILY.
# It REFUSES to start (HTTP 500) if any safeguard below is wrong or missing.

# --- required, no default ---
TG_ENVIRONMENT=production
TG_CLIENT_IP_SOURCE=vercel                      # rate limits key on the visitor's IP from Vercel's X-Forwarded-For (see the readiness report)
TG_SNAPSHOT_PIN_SHA256=e10ae7c6307885a1fbb0e8b872eae263c77f754f95885deb3022b604e9836697    # version 20261117T123454Z-a5d03a2afe; a public checksum, not a secret. Recompute with: python -m backend.index_snapshot pin
TG_CORS_ORIGINS=https://your-github-user.github.io
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key

# --- the model file (262 MiB) does not fit in the bundle: it is downloaded into MEMORY on a cold start (nothing is written to /tmp for it) ---
# The file is verified against the pinned SHA-256 and size before use, whatever the host. Use an https URL you have decided to trust to
# serve those exact bytes. The content-addressed Ollama registry blob below was downloaded and verified on 2026-11-15 (size, SHA-256,
# embeddings identical to the local model; see VERCEL-PILOT-READINESS.md section 10). It is not a secret.
KYR_MODEL_URL=https://registry.ollama.ai/v2/library/nomic-embed-text/blobs/sha256:970aa74c0a90ef7482477cf803618e776e173c007bf957f635f1015bfcfef0e6

# --- recommended: bound a slow provider, so a failed question cannot hold a function for minutes ---
PROVIDER_TIMEOUT_SECONDS=12
PROVIDER_MAX_RETRIES=0

# --- do not set on Vercel: TG_SOURCE_STATUS_FILE (unset = the bundled legal-status/source-status.json by absolute path; a relative value depends on the working directory), EMBEDDING_MODEL_FILE (the model is in memory), TG_DB_DIR, TG_LIFECYCLE_DIR, EMBEDDING_VERIFY=off, OLLAMA_ENABLED=true, TG_TRUSTED_PROXIES (ignored in this mode),
#     TG_APPROVAL_FILE / TG_TRUSTED_KEYS_FILE (no signed record or trusted-keys file is used; these are read only by the optional TG_PROVISION_VALIDITY layer, which is off) ---

# --- source files: the deployment folder must hold a copy of docs/legal-sources/telangana-traffic/source-documents at legal/source-documents.
#     backend/vercel_runtime.py then defaults TG_CORPUS_DIR to it, so every chunk's file hash is still checked against the real file (without it the service answers "unavailable"). ---
